# Neon Postgres (pulled by `neon deploy` / `neon env pull`)
# Pooled URL for app queries; unpooled for drizzle migrations
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=production

# App
NEXT_PUBLIC_APP_NAME=IHE Ops
NEXT_PUBLIC_COMPANY_NAME=Infinite Hardware & Electrical

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Vercel Blob, for supplier reply files
BLOB_READ_WRITE_TOKEN=

# Public site URL used in quote, invoice, and receipt emails
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend, for emailing document links + PDF attachments
# Verify the ihe.co.zw domain in Resend so sales@ can send
RESEND_API_KEY=
RESEND_FROM=Infinite Hardware & Electrical <sales@ihe.co.zw>

# Shared secret for website contact → enquiry intake (ihe-site sends as x-api-key)
INTAKE_API_KEY=

# Each staff user needs public metadata: { "role": "admin" | "sales" | "accounts" }
# In Clerk → Sessions → Customize session token, add:
# { "metadata": "{{user.public_metadata}}" }
