# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# App
NEXT_PUBLIC_APP_NAME=IHE Ops
NEXT_PUBLIC_COMPANY_NAME=Infinite Hardware & Electrical

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Vercel Blob, for supplier reply files
BLOB_READ_WRITE_TOKEN=

# Public site URL used in quote, invoice, and receipt emails
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend, for emailing document links
RESEND_API_KEY=
RESEND_FROM=IHE Ops <onboarding@resend.dev>

# Each staff user needs public metadata: { "role": "admin" | "sales" | "accounts" }
# In Clerk → Sessions → Customize session token, add:
# { "metadata": "{{user.public_metadata}}" }
